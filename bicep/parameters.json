{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "storageAccount": {
            "value": {
                "name": "stvoetbaloog",
                 "sku": "Standard_LRS"
            }
        },
       "keyVault": {
            "value": {
                "name": "kv-cdk-apps",
                "resourceGroup": "rg-core"
            }
        },
        "mongoDb": {
            "value": {
                "clusterName": "voetbaloog",
                "adminPasswordSecretName" : "voetbaloog-mongodb-admin-password"
            }
        },
        "cosmosAccount": {
            "value": {
                "name": "cosmon-voetbaloog",
                "tags": {
                    "application": "voetbaloog"
                },
                "consistencyLevel": "BoundedStaleness",
                "kind" : "MongoDB",
                "backupPolicy": {
                    "type": "Periodic",
                    "periodicModeProperties": {
                        "backupIntervalInMinutes": 1440,
                        "backupRetentionIntervalInHours": 48,
                        "backupStorageRedundancy": "Geo"
                    }
                },
                "database": {
                    "name": "voetbaloog",
                    "collections": [
                        {
                            "id": "pools",
                            "name": "pools",
                            "indexKey": "owner"
                        }
                    ]
                }                
            }
        },  
        "appServicePlan": {
            "value": {
                "name": "asp-voetbaloog",
                "sku": "F1"
            }
        },
        "website": {
            "value": {
                "name": "webapp-voetbaloog"
            }
        }
    }
}
